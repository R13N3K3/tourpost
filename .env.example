# Kopieren nach .env – diese Datei niemals veröffentlichen.
# test = nichts wird gepostet, live = echter Instagram-Upload
IG_MODE=test
YT_MODE=test
TT_MODE=test
IG_USER_ID=
IG_ACCESS_TOKEN=
# Leer lassen: im Live-Modus startet der Server selbst einen Cloudflare-Schnelltunnel (cloudflared nötig).
# Nur ausfüllen, wenn du einen festen Tunnel mit eigener Domain hast (HTTPS-Adresse des Medienservers).
PUBLIC_BASE_URL=
# YouTube (OAuth-Client aus der Google Cloud Console, Typ „Desktop-App")
YT_CLIENT_ID=
YT_CLIENT_SECRET=
# wird von `npm run youtube-auth` automatisch eingetragen
YT_REFRESH_TOKEN=
# public, unlisted oder private (zum Testen private)
YT_PRIVACY=public
# TikTok (App im TikTok-Developer-Portal, siehe README)
TT_CLIENT_KEY=
TT_CLIENT_SECRET=
# https-Adresse, die in der TikTok-App als Redirect-URI eingetragen ist
TT_REDIRECT_URI=
# wird von `npm run tiktok-auth` automatisch eingetragen
TT_REFRESH_TOKEN=
# SELF_ONLY (nur ich, bis zum App-Audit) oder PUBLIC_TO_EVERYONE
TT_PRIVACY=SELF_ONLY
# Port des Medienservers (liefert nur Videodateien aus, nur lokal erreichbar – diesen Port durch den Tunnel schicken)
MEDIA_PORT=3001
PORT=3000

# Fernzugriff von unterwegs (zweiter Modus): off = nur Heimnetz (Standard), tunnel = zusätzlich über eine
# Cloudflare-Adresse, nur für Geräte, die am PC per QR-Code gekoppelt wurden (npm run remote-pair). Einschalten: npm run remote-setup
REMOTE_MODE=off
# Lokaler Port der Fern-Tür (nur auf diesen zeigt der Fern-Tunnel)
REMOTE_PORT=3002
# Wie oft (in Minuten) die Tunnel-Adressen geprüft werden. Antwortet ein Tunnel zweimal nicht, obwohl das Internet geht, wird er neu gestartet.
TUNNEL_CHECK_MINUTES=5

# Optional: Push-Nachrichten aufs Handy über ntfy (https://ntfy.sh) – ein schwer erratbares Thema wählen
NTFY_TOPIC=
NTFY_SERVER=
