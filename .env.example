# Kopieren nach .env – diese Datei niemals veröffentlichen.
# test = nichts wird gepostet, live = echter Instagram-Upload
IG_MODE=test
YT_MODE=test
TT_MODE=test
IG_USER_ID=
IG_ACCESS_TOKEN=
# Öffentliche HTTPS-Adresse des Servers (z. B. Cloudflare Tunnel)
PUBLIC_BASE_URL=
# YouTube (OAuth-Client aus der Google Cloud Console, Typ „Desktop-App")
YT_CLIENT_ID=
YT_CLIENT_SECRET=
# wird von `npm run youtube-auth` automatisch eingetragen
YT_REFRESH_TOKEN=
# public, unlisted oder private (zum Testen private)
YT_PRIVACY=public
# Port des Medienservers (liefert nur Videodateien aus, nur lokal erreichbar – diesen Port durch den Tunnel schicken)
MEDIA_PORT=3001
PORT=3000

# Optional: Push-Nachrichten aufs Handy über ntfy (https://ntfy.sh) – ein schwer erratbares Thema wählen
NTFY_TOPIC=
NTFY_SERVER=
